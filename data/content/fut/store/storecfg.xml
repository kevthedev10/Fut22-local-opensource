		<!--
	        for the following documentation:
	          "item A" refers to the item whose content id is specified in the "id" attribute of the "dependency" tag
		    "condition D" refers to the condition tag that is specified in the "cond" attribute of the "dependency" tag
		    "entitlement E" refers to the entitlement tag that is specified in the "entitlement" attribute of the "dependency" tag
	          "item B" refers to the item whose content id is specified in the type of dependency tag's id attribute

		  the "show" attribute governs whether or not the item is shown if its prerequisites are not fulfilled. If show="true" then they are visible but nonpurchasable.

	        <preclusion id="<contentid>" />
	                preclusion   is where the purchase of item A, truth of condition D, or presence of entitlement E
				                 "precludes" the purchase of item B
	                id           is the content id of item B
				  show		 true if want to show item B as disabled or false (default) to hide completely

	        <prerequisite {id="<contentid>",entitlement="<tag>"} type="{and,or}" />
	                prerequisite  is where item A cannot be purchased before purchasing item B and/or entitlement C
	                id            is the content id of item B
				  entitlement   is the tag of entitlement C
				  cond		  is condition D
	                type          use "and" to link one or more prerequisites as (B and C and D)
	                              use "or" to link one or more prerequisites as (B or C or D)

	                Specifying both types "and" and "or" for a single item will result in the "and"
	                prerequisites only being evaluated. Ie. currently it is not possible to form
	                simple expressions combining "and" and "or".

	      -->
		<dependencies>
		</dependencies>
